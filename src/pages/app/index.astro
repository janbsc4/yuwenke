---
import { appLaunchResolverScript, localeUrl } from "../../lib/locale";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-title" content="Yuwenke" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <title>Yuwenke</title>
    <script is:inline data-app-launch set:html={appLaunchResolverScript()} />
  </head>
  <body>
    <p><a href={localeUrl("es")} lang="es">Abrir las cartas</a></p>
    <p><a href={localeUrl("en")} lang="en">Open the cards</a></p>
  </body>
</html>

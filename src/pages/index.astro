---
import { loadFlashcards } from "../data/loadFlashcards";
import { loadCardPackData } from "../data/loadCardPacks";
import { landingLangResolverScript, localeUrl } from "../lib/locale";
import { messages } from "../lib/messages";
import "../styles/landing.css";

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(base, Astro.site);
const socialImageUrl = new URL(`${base}og.png`, Astro.site);
const appUrl = (locale: "es" | "en") => localeUrl(locale);
const conversationUrl = (locale: "es" | "en") => `${appUrl(locale)}#conversation`;
const cards = loadFlashcards();
const { packs, packIdByCardId } = loadCardPackData(cards);
const cardsInPack = (packId: string) => cards.filter((card) => packIdByCardId[card.id] === packId).length;
const demoCard = cards.find((card) => card.id === "FC002")!;
const featuredPacks = [packs[0], packs[1], packs[5], packs[9]];
const meta = messages.es.metadata;
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={meta.description} data-content-es={messages.es.metadata.description} data-content-en={messages.en.metadata.description} />
    <meta name="theme-color" content="#f6f2ea" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={new URL(appUrl("es"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(appUrl("en"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yuwenke" />
    <meta property="og:title" content="Yuwenke" />
    <meta property="og:description" content={meta.socialDescription} data-content-es={messages.es.metadata.socialDescription} data-content-en={messages.en.metadata.socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={meta.ogImageAlt} data-content-es={messages.es.metadata.ogImageAlt} data-content-en={messages.en.metadata.ogImageAlt} />
    <title>Yuwenke · 语文课</title>
    <script is:inline set:html={landingLangResolverScript()} />
    <script is:inline data-install-suppression>
      window.addEventListener("beforeinstallprompt", (event) => event.preventDefault());
    </script>
    <script>
      import { initLandingPage } from "../lib/landing";
      initLandingPage();
    </script>
  </head>
  <body>
    <a class="lp-skip" href="#main"><span class="lang-es">Ir al contenido</span><span class="lang-en">Skip to content</span></a>
    <header class="lp-header lp-shell">
      <a class="lp-brand" href={base} aria-label="Yuwenke">
        <img src={`${base}yuwenke-mark.png`} alt="" width="40" height="40" />
        <span>Yuwenke <small lang="zh-Hans">语文课</small></span>
      </a>
      <nav class="lp-nav" aria-label="Yuwenke">
        <a href="#packs"><span class="lang-es">Las cartas</span><span class="lang-en">The cards</span></a>
        <a href="#lei"><span class="lang-es">Conoce a Léi</span><span class="lang-en">Meet Léi</span></a>
      </nav>
      <div class="lp-header-tools">
        <div class="lang-toggle" role="group" aria-label="Idioma / Language">
          <button type="button" data-set-lang="es" aria-pressed="true">ES</button>
          <button type="button" data-set-lang="en" aria-pressed="false">EN</button>
        </div>
        <a class="lp-button lp-button-small lp-button-ink lang-es" href={appUrl("es")}>Abrir la app <span aria-hidden="true">↗</span></a>
        <a class="lp-button lp-button-small lp-button-ink lang-en" href={appUrl("en")}>Open the app <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="lp-hero lp-shell" aria-labelledby="hero-title">
        <div class="lp-hero-copy">
          <h1 id="hero-title"><span class="lang-es">Más chino.<br /><em>Menos dramas con el búho.</em></span><span class="lang-en">More Chinese.<br /><em>Less owl-related guilt.</em></span></h1>
          <p class="lp-hero-sub"><span class="lang-es">Aprende palabras que sí vas a usar. Recuérdalas con cartas y úsalas en conversaciones con Léi, tu compañero con IA. Gratis y sin cuenta para empezar.</span><span class="lang-en">Learn words you’ll actually use. Remember them with flashcards, then use them in conversations with Léi, your AI partner. Free, with no account needed to start.</span></p>
          <div class="lp-actions">
            <a class="lp-button lp-button-primary lang-es" href={appUrl("es")}>Empezar gratis <span aria-hidden="true">→</span></a>
            <a class="lp-button lp-button-primary lang-en" href={appUrl("en")}>Start for free <span aria-hidden="true">→</span></a>
            <a class="lp-text-link lang-es" href={conversationUrl("es")}>Conversar con Léi <span aria-hidden="true">↗</span></a>
            <a class="lp-text-link lang-en" href={conversationUrl("en")}>Chat with Léi <span aria-hidden="true">↗</span></a>
          </div>
          <p class="lp-reassurance"><span aria-hidden="true">✓</span> <span class="lang-es">Sin suscripción. Sin tarjeta. Progreso guardado aquí.</span><span class="lang-en">No subscription. No credit card. Progress saved here.</span></p>
          <div class="lp-hero-footnote"><span class="lp-hanzi" lang="zh-Hans" aria-hidden="true">学</span><p><span class="lang-es">Que crezca tu chino.<br />No tu racha.</span><span class="lang-en">Grow your Chinese.<br />Not your streak.</span></p></div>
        </div>
        <div class="lp-preview-stage">
          <div class="lp-preview">
            <div class="lp-preview-header"><span class="lp-preview-brand">Yuwenke</span><span class="lp-preview-status"><span class="lp-dot" aria-hidden="true"></span><span class="lang-es">Ejemplo interactivo</span><span class="lang-en">Interactive preview</span></span></div>
            <div class="lp-preview-tabs" aria-hidden="true"><span class="is-active"><span class="lang-es">Estudiar</span><span class="lang-en">Study</span></span><span><span class="lang-es">Dominadas</span><span class="lang-en">Mastered</span></span><span><span class="lang-es">Favoritas</span><span class="lang-en">Favorites</span></span></div>
            <div class="lp-demo-meta"><span class="lang-es">Chino → Español</span><span class="lang-en">Chinese → English</span><span>{demoCard.id}</span></div>
            <article class="lp-demo-card">
              <p class="lp-demo-label"><span class="lang-es">{messages.es.card.promptEyebrow}</span><span class="lang-en">{messages.en.card.promptEyebrow}</span></p>
              <p class="lp-demo-hanzi lp-hanzi" lang="zh-Hans">{demoCard.hanzi}</p>
              <div class="lp-demo-placeholder" data-demo-placeholder><span class="lang-es">Piensa la respuesta.<br />Dila en voz alta. Comprueba.</span><span class="lang-en">Think it through.<br />Say it aloud. Then check.</span></div>
              <div class="lp-demo-answer" id="demo-answer" hidden aria-live="polite">
                <p class="lp-demo-meaning"><span class="lang-es">{demoCard.espanol}</span><span class="lang-en">{demoCard.ingles}</span><span lang="zh-Latn">{demoCard.pinyin}</span></p>
                <p class="lp-demo-explanation"><span class="lang-es">{demoCard.explicacion}</span><span class="lang-en">{demoCard.explicacion_ingles}</span></p>
                <div class="lp-demo-example"><p class="lp-hanzi" lang="zh-Hans">{demoCard.ejemplo_hanzi}</p><p lang="zh-Latn">{demoCard.ejemplo_pinyin}</p><p><span class="lang-es">{demoCard.ejemplo_espanol}</span><span class="lang-en">{demoCard.ejemplo_ingles}</span></p></div>
              </div>
              <button class="lp-demo-reveal" type="button" data-demo-reveal disabled aria-expanded="false" aria-controls="demo-answer">
                <span data-reveal-label><span class="lang-es">{messages.es.session.reveal}</span><span class="lang-en">{messages.en.session.reveal}</span></span>
                <span data-reset-label hidden><span class="lang-es">Probar otra vez</span><span class="lang-en">Try again</span></span>
                <span aria-hidden="true">↻</span>
              </button>
            </article>
          </div>
          <p class="lp-preview-caption"><span class="lp-caption-line" aria-hidden="true"></span><span class="lang-es">Una carta real. Pruébala aquí mismo.</span><span class="lang-en">A real card. Try it right here.</span></p>
        </div>
      </section>

      <div class="lp-facts lp-shell">
        <p><strong>{cards.length}</strong><span class="lang-es">palabras, frases y conceptos</span><span class="lang-en">words, phrases & concepts</span></p>
        <p><strong>{packs.length}</strong><span class="lang-es">packs para descubrir</span><span class="lang-en">packs to discover</span></p>
        <p><strong>ES / EN</strong><span class="lang-es">explicaciones en tu idioma</span><span class="lang-en">explanations in your language</span></p>
        <p><strong><span class="lp-hanzi" lang="zh-Hans">中文</span> ⇄ <span class="lang-es">ES</span><span class="lang-en">EN</span></strong><span class="lang-es">practica en ambos sentidos</span><span class="lang-en">practice both directions</span></p>
      </div>

      <section class="lp-packs lp-shell lp-section" id="packs" aria-labelledby="packs-title">
        <div class="lp-section-heading">
          <div><h2 id="packs-title"><span class="lang-es">Lo que quieres decir.<br />Un tema cada vez.</span><span class="lang-en">Things you want to say.<br />One topic at a time.</span></h2></div>
          <p class="lp-section-intro"><span class="lang-es">Tu primer pack ya está abierto. Elige el siguiente cuando te apetezca: sus cartas se suman a las que estás aprendiendo.</span><span class="lang-en">Your first pack is already open. Choose the next whenever you’re ready: its cards join the ones you’re learning.</span></p>
        </div>
        <div class="lp-pack-grid">
          {featuredPacks.map((pack, index) => (
            <article class="lp-pack" data-theme={pack.theme}>
              <div class="lp-pack-top"><span class="lp-pack-number">{String(packs.indexOf(pack) + 1).padStart(2, "0")}</span><span class="lp-pack-state"><span class="lang-es">{index === 0 ? "Tu primer pack" : "Por descubrir"}</span><span class="lang-en">{index === 0 ? "Your first pack" : "To discover"}</span></span></div>
              <span class="lp-pack-mark lp-hanzi" lang="zh-Hans">{pack.mark}</span>
              <h3><span class="lang-es">{pack.title.es}</span><span class="lang-en">{pack.title.en}</span></h3>
              <p><span class="lang-es">{pack.description.es}</span><span class="lang-en">{pack.description.en}</span></p>
              <div class="lp-pack-bottom"><span>{cardsInPack(pack.id)} <span class="lang-es">cartas</span><span class="lang-en">cards</span></span><span lang="zh-Hans" aria-hidden="true">语文课</span></div>
            </article>
          ))}
        </div>
        <p class="lp-pack-link"><a class="lp-text-link lang-es" href={appUrl("es")}>Descubre los {packs.length} packs en la app <span aria-hidden="true">→</span></a><a class="lp-text-link lang-en" href={appUrl("en")}>Discover all {packs.length} packs in the app <span aria-hidden="true">→</span></a></p>
      </section>

      <section class="lp-method lp-shell lp-section" aria-labelledby="method-title">
        <div class="lp-section-heading"><div><h2 id="method-title"><span class="lang-es">Menos ruido.<br />Más espacio para aprender.</span><span class="lang-en">Less noise.<br />More room to learn.</span></h2></div><p class="lp-section-intro"><span class="lang-es">Una carta cada vez. Sin rachas que salvar ni búhos que decepcionar. Tú decides qué sabes y qué quieres seguir practicando.</span><span class="lang-en">One card at a time. No streaks to save. No owls to disappoint. You decide what you know and what you want to keep practicing.</span></p></div>
        <div class="lp-method-grid">
          <article><span class="lp-feature-mark lp-hanzi" lang="zh-Hans" aria-hidden="true">忆</span><h3><span class="lang-es">Recuerda, no solo leas</span><span class="lang-en">Recall, don’t just read</span></h3><p><span class="lang-es">Piensa antes de revelar. Practica palabras y frases en ambos sentidos, y recuerda las reglas con cartas de conceptos.</span><span class="lang-en">Think before revealing. Practice words and phrases in both directions, and recall the rules with concept cards.</span></p></article>
          <article><span class="lp-feature-mark" aria-hidden="true">☆</span><h3><span class="lang-es">Haz tuya la colección</span><span class="lang-en">Make the collection yours</span></h3><p><span class="lang-es">Marca lo que ya sabes como Dominadas. Guarda Favoritas para volver a ellas y encuentra una carta con la búsqueda y los filtros.</span><span class="lang-en">Move what you know to Mastered. Save Favorites to revisit, and find a card with search and filters.</span></p></article>
          <article><span class="lp-feature-mark lp-hanzi" lang="zh-Hans" aria-hidden="true">听</span><h3><span class="lang-es">Escucha. Dilo en voz alta.</span><span class="lang-en">Listen. Say it aloud.</span></h3><p><span class="lang-es">Lee el pinyin y escucha la pronunciación con las voces chinas disponibles en tu dispositivo. Elige tu voz o estudia en silencio.</span><span class="lang-en">Read the pinyin and hear pronunciation with the Chinese voices available on your device. Pick your voice or study quietly.</span></p></article>
        </div>
      </section>

      <section class="lp-lei" id="lei" aria-labelledby="lei-title">
        <div class="lp-shell lp-lei-inner">
          <div class="lp-lei-copy">
            <h2 id="lei-title"><span class="lang-es">No solo elijas la respuesta.<br /><em>Escribe la tuya.</em></span><span class="lang-en">Don’t just pick an answer.<br /><em>Write your own.</em></span></h2>
            <p><span class="lang-es">Pide un té. Habla de tu familia. Cuenta qué te gusta. Con Léi, tu compañero de conversación con IA, formas tus propias frases con las palabras que estás aprendiendo. Tú respondes y la conversación sigue.</span><span class="lang-en">Order tea. Talk about your family. Say what you like. With Léi, your AI conversation partner, you build your own sentences from the words you’re learning. You answer, and the conversation moves on.</span></p>
            <ul class="lp-lei-features">
              <li><span aria-hidden="true">↳</span><span class="lang-es">Conversaciones cortas, sobre el tema que elijas.</span><span class="lang-en">Short conversations, on a topic you choose.</span></li>
              <li><span aria-hidden="true">↳</span><span class="lang-es">Pinyin, traducción y una posible respuesta cuando los necesites.</span><span class="lang-en">Pinyin, translation, and a possible answer when you need them.</span></li>
              <li><span aria-hidden="true">↳</span><span class="lang-es">Sugerencias para sonar más natural y explicaciones en español.</span><span class="lang-en">Suggestions to sound more natural and explanations in English.</span></li>
            </ul>
            <a class="lp-button lp-button-light lang-es" href={conversationUrl("es")}>Prueba una conversación <span aria-hidden="true">↗</span></a>
            <a class="lp-button lp-button-light lang-en" href={conversationUrl("en")}>Try a conversation <span aria-hidden="true">↗</span></a>
            <p class="lp-lei-note"><span class="lang-es">Prueba tres mensajes sin cuenta. Después, sigue gratis con Google, dentro de los límites de uso. Necesitas conexión.</span><span class="lang-en">Try three messages without an account. Then keep chatting for free with Google sign-in, within usage limits. Internet required.</span></p>
          </div>
          <figure class="lp-chat-example">
            <figcaption><span class="lp-chat-seal lp-hanzi" lang="zh-Hans" aria-hidden="true">雷</span><span><strong>Léi</strong><small><span class="lang-es">Compañero de conversación</span><span class="lang-en">Conversation partner</span></small></span><span class="lp-example-label"><span class="lang-es">Ejemplo</span><span class="lang-en">Example</span></span></figcaption>
            <div class="lp-chat-line"><span class="lp-speaker">Léi</span><p class="lp-hanzi" lang="zh-Hans">你喜欢喝茶吗？</p><details class="lp-chat-help"><summary><span class="lang-es">Pinyin y traducción</span><span class="lang-en">Pinyin & translation</span></summary><p class="lp-ruby lp-hanzi" lang="zh-Hans"><ruby>你<rt>nǐ</rt></ruby><ruby>喜<rt>xǐ</rt></ruby><ruby>欢<rt>huān</rt></ruby><ruby>喝<rt>hē</rt></ruby><ruby>茶<rt>chá</rt></ruby><ruby>吗<rt>ma</rt></ruby>？</p><p><span class="lang-es">¿Te gusta beber té?</span><span class="lang-en">Do you like drinking tea?</span></p></details></div>
            <div class="lp-chat-answer"><span class="lp-speaker"><span class="lang-es">Tú</span><span class="lang-en">You</span></span><p class="lp-hanzi" lang="zh-Hans">我喝喜欢茶。</p><details class="lp-naturalness"><summary><span class="lang-es">A mejorar</span><span class="lang-en">Needs work</span><span aria-hidden="true">⌄</span></summary><p><span class="lang-es">Coloca 喜欢 (xǐhuān — gustar) antes de 喝 (hē — beber).</span><span class="lang-en">Put 喜欢 (xǐhuān — to like) before 喝 (hē — to drink).</span></p><p class="lp-hanzi" lang="zh-Hans">我喜欢喝茶。</p></details></div>
            <div class="lp-chat-line"><span class="lp-speaker">Léi</span><p class="lp-hanzi" lang="zh-Hans">你喜欢喝什么茶？</p><p class="lp-chat-translation"><span class="lang-es">¿Qué té te gusta beber?</span><span class="lang-en">What tea do you like drinking?</span></p></div>
            <div class="lp-chat-question"><span aria-hidden="true">?</span><p><span class="lang-es">¿Una duda de gramática? Pregunta también. Léi te la explica en español.</span><span class="lang-en">A grammar question? Ask that too. Léi explains it in English.</span></p></div>
          </figure>
        </div>
      </section>

      <section class="lp-practical lp-shell lp-section" aria-labelledby="practical-title">
        <div><h2 id="practical-title"><span class="lang-es">Gratis para aprender.<br />Fácil para empezar.</span><span class="lang-en">Free to learn.<br />Easy to start.</span></h2><p class="lp-practical-benefit"><span class="lang-es">Abre la app y empieza con tu primera palabra. Estudia sin cuenta, guarda lo que te cuesta y vuelve cuando quieras. Tu progreso te espera; una notificación culpabilizadora, no.</span><span class="lang-en">Open the app and start with your first word. Study without an account, save the tricky bits, and come back whenever you like. Your progress will be waiting. A guilt-trip notification won’t.</span></p></div>
        <div class="lp-faq">
          <details><summary><span class="lang-es">¿De verdad es gratis?</span><span class="lang-en">Really free?</span><span aria-hidden="true">+</span></summary><p><span class="lang-es">Sí. Las cartas y los packs son gratis, sin suscripción. Léi también es gratis, con límites de uso: prueba tres mensajes sin cuenta e inicia sesión con Google para continuar.</span><span class="lang-en">Yes. Cards and packs are free, with no subscription. Léi is free too, with usage limits: try three messages without an account, then sign in with Google to continue.</span></p></details>
          <details open><summary><span class="lang-es">¿Necesito una cuenta?</span><span class="lang-en">Do I need an account?</span><span aria-hidden="true">+</span></summary><p><span class="lang-es">No para estudiar. Tu progreso, favoritas y packs abiertos se guardan en este dispositivo. Inicia sesión con Google si quieres sincronizarlos entre dispositivos.</span><span class="lang-en">Not to study. Your progress, favorites, and open packs are saved on this device. Sign in with Google if you want to sync them across devices.</span></p></details>
          <details><summary><span class="lang-es">¿Puedo estudiar sin conexión?</span><span class="lang-en">Can I study offline?</span><span aria-hidden="true">+</span></summary><p><span class="lang-es">Sí, las cartas funcionan sin conexión después de cargar la app. Conversar con Léi e iniciar sesión necesitan internet.</span><span class="lang-en">Yes, cards work offline after the app has loaded. Chatting with Léi and signing in need internet.</span></p></details>
          <details><summary><span class="lang-es">¿Dónde se guardan mis conversaciones?</span><span class="lang-en">Where are my conversations saved?</span><span aria-hidden="true">+</span></summary><p><span class="lang-es">Los últimos doce intercambios se guardan en tu navegador, separados por cuenta e idioma. Al conversar, se envían un historial limitado y vocabulario al servicio de IA; no se guardan transcripciones en Firestore ni en el backend de Yuwenke.</span><span class="lang-en">The latest twelve exchanges stay in your browser, separated by account and language. During chat, bounded history and vocabulary are sent to the AI service; transcripts aren’t stored in Firestore or Yuwenke’s backend.</span></p></details>
        </div>
      </section>

      <section class="lp-closing lp-shell" aria-labelledby="closing-title"><span class="lp-closing-mark lp-hanzi" lang="zh-Hans" aria-hidden="true">学</span><div><h2 id="closing-title"><span class="lang-es">El resto viene con la práctica.</span><span class="lang-en">The rest comes with practice.</span></h2></div><a class="lp-button lp-button-primary lang-es" href={appUrl("es")}>Abrir Yuwenke <span aria-hidden="true">→</span></a><a class="lp-button lp-button-primary lang-en" href={appUrl("en")}>Open Yuwenke <span aria-hidden="true">→</span></a></section>
    </main>
    <footer class="lp-footer lp-shell"><a class="lp-brand" href={base}>Yuwenke <small lang="zh-Hans">语文课</small></a><p><span class="lang-es">Aprende palabras. Ten algo que decir.</span><span class="lang-en">Learn words. Have something to say.</span></p><a href="#main"><span class="lang-es">Volver arriba</span><span class="lang-en">Back to top</span> ↑</a></footer>
    <noscript><p class="lp-noscript"><span class="lang-es">Activa JavaScript para probar la carta. </span><span class="lang-en">Enable JavaScript to try the card. </span><a href={appUrl("es")}>Español</a> · <a href={appUrl("en")}>English</a></p></noscript>
  </body>
</html>

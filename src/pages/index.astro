---
import {
  AVAILABLE_LOCALES,
  DEFAULT_LOCALE,
  LOCALE_STORAGE_KEY,
} from "../lib/locale";
import { messages } from "../lib/messages";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(base, Astro.site);
const meta = messages[DEFAULT_LOCALE].metadata;
const assetUrl = (filename: string) => `${base}${filename}`;
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={assetUrl("favicon.ico")} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={assetUrl("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="canonical" href={canonicalUrl} />
    <title>Yuwenke</title>
    <script
      is:inline
      define:vars={{
        storageKey: LOCALE_STORAGE_KEY,
        available: AVAILABLE_LOCALES,
        fallback: DEFAULT_LOCALE,
        base,
      }}
    >
      // Root locale resolver: saved choice first, then browser negotiation with
      // English as the fallback. Mirrors resolveLocalePreference in locale.ts.
      (function () {
        var saved = null;
        try {
          saved = window.localStorage.getItem(storageKey);
        } catch (error) {}
        var target = available.indexOf(saved) >= 0 ? saved : null;
        if (!target) {
          var languages = navigator.languages || [navigator.language || ""];
          var prefersSpanish = false;
          for (var index = 0; index < languages.length; index += 1) {
            var language = String(languages[index] || "").toLowerCase();
            if (language.indexOf("es") === 0) {
              prefersSpanish = true;
              break;
            }
          }
          target = prefersSpanish ? "es" : "en";
          if (available.indexOf(target) < 0) target = fallback;
        }
        window.location.replace(base + target + "/");
      })();
    </script>
  </head>
  <body>
    <noscript>
      <p class="noscript-message">
        <a href={`${base}${DEFAULT_LOCALE}/`}>{meta.noscript}</a>
      </p>
    </noscript>
  </body>
</html>

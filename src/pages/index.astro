---
import FlashcardApp from "../components/FlashcardApp";
import { loadFlashcards } from "../data/loadFlashcards";
import { loadCardPackData } from "../data/loadCardPacks";
import "../styles/global.css";

const cards = loadFlashcards();
const { packs, packIdByCardId } = loadCardPackData(cards);
const canonicalUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const socialImageUrl = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site);
const assetUrl = (filename: string) => `${import.meta.env.BASE_URL}${filename}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Tarjetas de vocabulario, frases y conceptos de mandarín con explicaciones en español."
    />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-title" content="Yuwenke" />
    <link rel="icon" href={assetUrl("favicon.ico")} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={assetUrl("favicon-32.png")} type="image/png" sizes="32x32" />
    <link
      rel="apple-touch-icon"
      href={assetUrl("apple-touch-icon.png")}
      sizes="180x180"
    />
    <link rel="manifest" href={assetUrl("site.webmanifest")} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Yuwenke" />
    <meta property="og:title" content="Yuwenke" />
    <meta
      property="og:description"
      content="Mandarín y español en dos sentidos, a partir de mis notas de clase."
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content="Yuwenke, tarjetas de mandarín y español"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Yuwenke" />
    <meta
      name="twitter:description"
      content="Mandarín y español en dos sentidos, a partir de mis notas de clase."
    />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>Yuwenke</title>
  </head>
  <body>
    <FlashcardApp cards={cards} packs={packs} packIdByCardId={packIdByCardId} client:load />
    <noscript>
      <p class="noscript-message">Necesitas activar JavaScript para usar las tarjetas.</p>
    </noscript>
  </body>
</html>

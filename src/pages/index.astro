---
import { loadFlashcards } from "../data/loadFlashcards";
import { loadCardPackData } from "../data/loadCardPacks";
import { landingLangResolverScript, localeUrl } from "../lib/locale";
import { messages } from "../lib/messages";
import { DEFAULT_CHAT_MODEL, chatModelLabel } from "../../shared/chat";
import "../styles/landing.css";

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(base, Astro.site);
const socialImageUrl = new URL(`${base}og.png`, Astro.site);
const fontUrl = `${base}fonts/young-serif-latin.woff2`;
const appUrl = (locale: "es" | "en") => localeUrl(locale);
const conversationUrl = (locale: "es" | "en") => `${appUrl(locale)}#conversation`;

const cards = loadFlashcards();
const { packs, packIdByCardId } = loadCardPackData(cards);
const cardsInPack = (packId: string) =>
  cards.filter((card) => packIdByCardId[card.id] === packId).length;

const cardById = new Map(cards.map((card) => [card.id, card]));
const demoCard = cardById.get("FC002")!;
const fanCards = ["FC001", "FC012"].map((id) => cardById.get(id)!);
const shelfPacks = packs.slice(0, 3);
const meta = messages.es.metadata;
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#f5f0e6" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" hreflang="es" href={new URL(appUrl("es"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(appUrl("en"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yuwenke" />
    <meta property="og:title" content="Yuwenke" />
    <meta property="og:description" content={meta.socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <title>Yuwenke · 语文课</title>
    <script is:inline set:html={landingLangResolverScript()} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <style is:inline set:html={`@font-face{font-family:"Young Serif";font-style:normal;font-weight:400;font-display:swap;src:url('${fontUrl}') format("woff2");}`}></style>
    <script>
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLButtonElement>("[data-set-lang]");
      const syncPressed = () => {
        root.lang = root.dataset.lang === "en" ? "en" : "es";
        for (const button of toggles) {
          button.setAttribute("aria-pressed", String(button.dataset.setLang === root.dataset.lang));
        }
      };
      syncPressed();
      for (const button of toggles) {
        button.addEventListener("click", () => {
          const lang = button.dataset.setLang === "en" ? "en" : "es";
          root.dataset.lang = lang;
          root.lang = lang;
          syncPressed();
          try {
            window.localStorage.setItem("yuwenke:locale:v1", lang);
          } catch {
            /* guest mode keeps working without storage */
          }
        });
      }
    </script>
    <script>
      const flip = document.querySelector<HTMLButtonElement>(".lp-flip");
      flip?.addEventListener("click", () => {
        const revealed = flip.getAttribute("aria-pressed") !== "true";
        flip.setAttribute("aria-pressed", String(revealed));
        flip.querySelector(".lp-face-front")?.setAttribute("aria-hidden", String(revealed));
        flip.querySelector(".lp-face-back")?.setAttribute("aria-hidden", String(!revealed));
      });
    </script>
    <script>
      const placed = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add(
            entry.target.classList.contains("lp-footer") ? "is-stamped" : "is-set",
          );
          observer.unobserve(entry.target);
        }
      };
      const observer = new IntersectionObserver(placed, { threshold: 0.25 });
      for (const section of document.querySelectorAll(".lp-steps, .lp-footer")) {
        observer.observe(section);
      }
    </script>
    <script>
      const rotor = document.querySelector<HTMLElement>(".lp-rotor");
      const stage = document.querySelector<HTMLElement>(".lp-hero-stage");
      const finePointer = matchMedia("(pointer: fine)");
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      let frame = 0;
      if (rotor && stage) {
        stage.addEventListener("pointermove", (event) => {
          if (!finePointer.matches || reducedMotion.matches || rotor.closest(".lp-flip")?.getAttribute("aria-pressed") === "true") return;
          if (frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            const bounds = stage.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            rotor.style.setProperty("--tilt-x", `${(-y * 5).toFixed(2)}deg`);
            rotor.style.setProperty("--tilt-y", `${(x * 6).toFixed(2)}deg`);
          });
        });
        stage.addEventListener("pointerleave", () => {
          rotor.style.setProperty("--tilt-x", "0deg");
          rotor.style.setProperty("--tilt-y", "0deg");
        });
      }
    </script>
  </head>
  <body>
    <div class="lp-shell">
      <header class="lp-header">
        <a class="lp-brand" href={base} aria-label="Yuwenke">
          <img src={`${base}yuwenke-mark.png`} alt="" width="46" height="46" />
          <span>
            <strong>Yuwenke</strong>
            <small><span class="lp-hanzi" lang="zh-Hans">语文课</span> · <span class="lang-es">clase de chino</span><span class="lang-en">Chinese class</span></small>
          </span>
        </a>
        <div class="lp-header-tools">
          <div class="lang-toggle" role="group" aria-label="Idioma / Language">
            <button type="button" data-set-lang="es" aria-pressed="true">ES</button>
            <button type="button" data-set-lang="en" aria-pressed="false">EN</button>
          </div>
          <a class="lp-button lp-button-primary lp-header-cta lang-es" href={appUrl("es")}>
            Abrir las cartas
          </a>
          <a class="lp-button lp-button-primary lp-header-cta lang-en" href={appUrl("en")}>
            Open the cards
          </a>
        </div>
      </header>

      <main>
        <section class="lp-hero">
          <div class="lp-hero-copy">
            <p class="lp-eyebrow lp-rise lp-rise-1">
              <span class="lp-hanzi" lang="zh-Hans">语文课</span>
              <span aria-hidden="true">·</span>
              <span>yǔwén kè</span>
            </p>
            <h1 class="lp-rise lp-rise-2">
              <span class="lang-es">De cero a chino, <em>carta a carta</em>.</span>
              <span class="lang-en">Learn Chinese, <em>card by card.</em></span>
            </h1>
            <p class="lp-hero-sub lp-rise lp-rise-3">
              <span class="lang-es">
                Mandarín de clase, en cartas con hanzi, pinyin y explicaciones en español.
                Aprende a tu ritmo y usa tus palabras en una conversación con Léi.
              </span>
              <span class="lang-en">
                Mandarin from real class notes, with hanzi, pinyin, and explanations in English.
                Learn at your pace, then use your words in a conversation with Léi.
              </span>
            </p>
            <div class="lp-hero-actions lp-rise lp-rise-4">
              <a class="lp-button lp-button-primary lang-es" href={appUrl("es")}>
                Abrir las cartas <span class="lp-hanzi" lang="zh-Hans">学</span>
              </a>
              <a class="lp-button lp-button-primary lang-en" href={appUrl("en")}>
                Open the cards <span class="lp-hanzi" lang="zh-Hans">学</span>
              </a>
              <a class="lp-button lp-button-ghost lang-es" href="#lei">Conoce a Léi</a>
              <a class="lp-button lp-button-ghost lang-en" href="#lei">Meet Léi</a>
            </div>
            <p class="lp-hero-reassurance lp-rise lp-rise-5">
              <span class="lang-es">Cartas sin cuenta · Progreso guardado en este dispositivo</span>
              <span class="lang-en">Flashcards without an account · Progress saved on this device</span>
            </p>
            <p class="lp-hero-counts lp-rise lp-rise-5">
              <span><strong>{cards.length}</strong> <span class="lang-es">cartas</span><span class="lang-en">cards</span></span>
              <span><strong>{packs.length}</strong> <span class="lang-es">packs por abrir</span><span class="lang-en">packs to open</span></span>
              <span><strong class="lang-es">ES</strong><strong class="lang-en">EN</strong> ⇄ <strong class="lp-hanzi" lang="zh-Hans">中文</strong></span>
            </p>
          </div>

          <div class="lp-hero-stage">
            <ul class="lp-fan">
              {
                fanCards.map((card) => (
                  <li class="lp-fan-item" aria-hidden="true">
                    <div class="lp-dealer">
                      <div class="lp-face lp-face-front">
                        <div class="lp-face-main">
                          <span class="lp-hanzi" lang="zh-Hans">{card.hanzi}</span>
                        </div>
                      </div>
                    </div>
                  </li>
                ))
              }
              <li class="lp-fan-item lp-demo-card">
                <div class="lp-dealer">
                  <button type="button" class="lp-flip" aria-pressed="false">
                    <span class="lp-rotor">
                      <span class="lp-face lp-face-front" aria-hidden="false">
                        <span class="lp-face-head">
                          <span class="lang-es"><span class="lp-hanzi" lang="zh-Hans">中</span> → ES</span>
                          <span class="lang-en"><span class="lp-hanzi" lang="zh-Hans">中</span> → EN</span>
                          <span class="lp-hanzi" lang="zh-Hans" aria-hidden="true">{demoCard.tipo === 'palabra' ? '词' : '句'}</span>
                        </span>
                        <span class="lp-face-main">
                          <span class="lp-hanzi" lang="zh-Hans">{demoCard.hanzi}</span>
                          <span class="lp-pinyin">{demoCard.pinyin}</span>
                        </span>
                        <span class="lp-face-hint">
                          <span class="lp-flip-icon" aria-hidden="true">↻</span>
                          <span class="lang-es">Toca la carta para girarla</span>
                          <span class="lang-en">Tap the card to flip it</span>
                        </span>
                      </span>
                      <span class="lp-face lp-face-back" aria-hidden="true">
                        <span class="lp-face-head">
                          <span class="lang-es">Respuesta</span>
                          <span class="lang-en">Answer</span>
                          <span class="lang-es"><span class="lp-hanzi" lang="zh-Hans">中</span> → ES</span>
                          <span class="lang-en"><span class="lp-hanzi" lang="zh-Hans">中</span> → EN</span>
                        </span>
                        <span class="lp-face-main">
                          <span class="lp-gloss lang-es">{demoCard.espanol}</span>
                          <span class="lp-gloss lang-en">{demoCard.ingles}</span>
                          <span class="lp-face-example">
                            <span class="lp-hanzi" lang="zh-Hans">{demoCard.ejemplo_hanzi}</span>
                            <span class="lp-pinyin">{demoCard.ejemplo_pinyin}</span>
                            <span class="lang-es">{demoCard.ejemplo_espanol}</span>
                            <span class="lang-en">{demoCard.ejemplo_ingles}</span>
                          </span>
                        </span>
                        <span class="lp-face-hint">
                          <span class="lp-flip-icon" aria-hidden="true">↻</span>
                          <span class="lang-es">Otra vez</span>
                          <span class="lang-en">Flip again</span>
                        </span>
                      </span>
                    </span>
                  </button>
                </div>
              </li>
            </ul>
            <p class="lp-stack-caption">
              <span class="lang-es">Carta real de la baraja ·</span>
              <span class="lang-en">A real card from the deck ·</span>
              <span class="lp-hanzi" lang="zh-Hans"> 你</span> FC002
            </p>
          </div>
        </section>

        <section class="lp-lei" id="lei" aria-labelledby="lei-title">
          <div class="lp-section-head lp-lei-copy">
            <p class="lp-eyebrow"><span class="lang-es">Practica con Léi</span><span class="lang-en">Practice with Léi</span></p>
            <h2 id="lei-title">
              <span class="lang-es">Tus palabras ya pueden conversar.</span>
              <span class="lang-en">Put your words into conversation.</span>
            </h2>
            <p>
              <span class="lang-es">Léi es tu compañero de conversación con IA. Usa las palabras que estás aprendiendo y las que ya sabes para ayudarte a formar tus propias frases en chino.</span>
              <span class="lang-en">Léi is your AI conversation partner. It uses the words you're learning and the ones you already know to help you make your own sentences in Chinese.</span>
            </p>
            <p>
              <span class="lang-es">Elige un tema, responde a una pregunta y sigue la conversación. Despliega el pinyin, la traducción o una pista cuando lo necesites, con correcciones breves en español.</span>
              <span class="lang-en">Choose a topic, answer a question, and keep the conversation going. Reveal pinyin, a translation, or a hint when you need one, with brief corrections in English.</span>
            </p>
            <div class="lp-lei-actions">
              <a class="lp-button lp-button-jade lang-es" href={conversationUrl("es")}>Conversar con Léi <span aria-hidden="true">↗</span></a>
              <a class="lp-button lp-button-jade lang-en" href={conversationUrl("en")}>Chat with Léi <span aria-hidden="true">↗</span></a>
            </div>
            <p class="lp-lei-note">
              <span class="lang-es">Prueba tres mensajes gratis sin iniciar sesión. Después, entra con Google para seguir. Necesitas conexión a internet.</span>
              <span class="lang-en">Try three messages free without signing in. Then sign in with Google to continue. An internet connection is required.</span>
            </p>
          </div>
          <figure class="lp-lei-example">
            <figcaption>
              <span class="lp-lei-seal lp-hanzi" lang="zh-Hans" aria-hidden="true">雷</span>
              <span><strong>Léi</strong><small>{chatModelLabel(DEFAULT_CHAT_MODEL)}</small></span>
              <span class="lp-lei-example-label"><span class="lang-es">Conversación de ejemplo</span><span class="lang-en">Example conversation</span></span>
            </figcaption>
            <div class="lp-lei-words">
              <span class="lang-es">Palabras para practicar</span><span class="lang-en">Words to practice</span>
              <span class="lp-hanzi" lang="zh-Hans">喝 <span aria-hidden="true">·</span> 茶 <span aria-hidden="true">·</span> 喜欢</span>
            </div>
            <div class="lp-lei-line">
              <span class="lp-lei-speaker">Léi</span>
              <p class="lp-hanzi" lang="zh-Hans">你喜欢喝茶吗？</p>
              <details>
                <summary><span class="lang-es">Ver pinyin y traducción</span><span class="lang-en">Show pinyin and translation</span></summary>
                <p>Nǐ xǐhuān hē chá ma?</p>
                <p class="lang-es">¿Te gusta beber té?</p><p class="lang-en">Do you like drinking tea?</p>
              </details>
            </div>
            <div class="lp-lei-answer">
              <span class="lp-lei-speaker"><span class="lang-es">Tú</span><span class="lang-en">You</span></span>
              <p class="lp-hanzi" lang="zh-Hans">我喝喜欢茶。</p>
            </div>
            <div class="lp-lei-feedback">
              <span class="lp-lei-speaker">Léi</span>
              <p class="lang-es">Primero 喜欢, luego 喝. Prueba así:</p>
              <p class="lang-en">Put 喜欢 before 喝. Try this:</p>
              <p class="lp-hanzi" lang="zh-Hans">我喜欢喝茶。</p>
              <p class="lp-lei-gloss"><span class="lang-es">Me gusta beber té.</span><span class="lang-en">I like drinking tea.</span></p>
            </div>
          </figure>
        </section>

        <section class="lp-steps" id="como-funciona" aria-labelledby="steps-title">
          <div class="lp-section-head">
            <p class="lp-eyebrow lang-es">Cómo funciona</p>
            <p class="lp-eyebrow lang-en">How it works</p>
            <h2 id="steps-title">
              <span class="lang-es">Abre un pack. Aprende a tu ritmo.</span>
              <span class="lang-en">Open a pack. Learn at your pace.</span>
            </h2>
          </div>
          <div class="lp-step-grid">
            <svg class="lp-step-arrow" viewBox="0 0 54 34" aria-hidden="true" fill="none">
              <path pathLength="1" d="M2 26 C 18 30, 34 16, 46 10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="1" />
              <path d="M39 6 L47 9 L43 16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
            <svg class="lp-step-arrow" viewBox="0 0 54 34" aria-hidden="true" fill="none">
              <path pathLength="1" d="M2 26 C 18 30, 34 16, 46 10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="1" />
              <path d="M39 6 L47 9 L43 16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
            <div class="lp-step">
              <span class="lp-step-marker" lang="zh-Hans" aria-hidden="true">一</span>
              <small>yī</small>
              <h3 class="lang-es">Abre un pack</h3>
              <h3 class="lang-en">Open a pack</h3>
              <p class="lang-es">
                Elige un tema y abre su pack. Sus cartas nuevas se unen a las que ya estás
                aprendiendo en una sola cola de Estudiar.
              </p>
              <p class="lang-en">
                Choose a topic and open its pack. Its new cards join the ones you are already
                learning in one Study queue.
              </p>
              <p class="lp-hanzi-flow lp-hanzi" lang="zh-Hans">看 · 学 · 会</p>
            </div>
            <div class="lp-step">
              <span class="lp-step-marker" lang="zh-Hans" aria-hidden="true">二</span>
              <small>èr</small>
              <h3 class="lang-es">Estudia</h3>
              <h3 class="lang-en">Study</h3>
              <p class="lang-es">
                Revela la respuesta y decide: seguir aprendiendo, marcarla como dominada o
                saltarla por ahora. Practica palabras en ambos sentidos y conceptos como reglas.
              </p>
              <p class="lang-en">
                Reveal the answer, then keep learning, mark it as mastered, or skip it for now.
                Practice words in both directions and concepts as rules.
              </p>
              <p class="lp-hanzi-flow lp-hanzi">
                <span lang="zh-Hans">中</span> ⇄ <span class="lang-es">ES</span><span class="lang-en">EN</span>
              </p>
            </div>
            <div class="lp-step">
              <span class="lp-step-marker" lang="zh-Hans" aria-hidden="true">三</span>
              <small>sān</small>
              <h3 class="lang-es">Domina</h3>
              <h3 class="lang-en">Master</h3>
              <p class="lang-es">
                Lo que ya te sale se queda en tu colección. Vuelve a repasarla o mándala de
                vuelta cuando quieras reforzarla.
              </p>
              <p class="lang-en">
                What you already know stays in your collection. Review it anytime, or send it
                back whenever you want to reinforce it.
              </p>
              <p class="lp-hanzi-flow lp-hanzi">
                <span class="lang-es">Tu muro</span>
                <span class="lang-en">Your wall</span>
                <span lang="zh-Hans">· 墙</span>
              </p>
            </div>
          </div>
        </section>

        <section class="lp-packs" aria-labelledby="packs-title">
          <div class="lp-packs-inner">
            <div class="lp-section-head">
              <p class="lp-eyebrow lang-es">Packs</p>
              <p class="lp-eyebrow lang-en">Packs</p>
              <h2 id="packs-title">
                <span class="lang-es">Cada tema llega como un sobre sin abrir.</span>
                <span class="lang-en">Every topic arrives as a sealed pack.</span>
              </h2>
              <p>
                <span class="lang-es">
                  Abre un pack cuando quieras y sus cartas entran en Estudiar. Los packs no se
                  cierran: tu colección solo crece.
                </span>
                <span class="lang-en">
                  Open a pack whenever you like and its cards join Study. Packs never close:
                  your collection only grows.
                </span>
              </p>
            </div>
            <div class="lp-pack-stage">
              {
                shelfPacks.map((pack, index) => {
                  const isMain = index === 0;
                  return (
                    <div
                      class:list={[
                        "lp-pack",
                        {
                          "lp-pack-back lp-pack-back-1": index === 1,
                          "lp-pack-back lp-pack-back-2": index === 2,
                        },
                      ]}
                      data-theme={pack.theme}
                      aria-hidden={isMain ? undefined : "true"}
                    >
                      <div class="lp-pack-body">
                        <span class="lp-pack-crimp lp-pack-crimp-top" />
                        <span class="lp-pack-edition">Yuwenke · <span class="lp-hanzi" lang="zh-Hans">语文课</span></span>
                        <span class="lp-pack-mark lp-hanzi" lang="zh-Hans">{pack.mark}</span>
                        {isMain && <span class="lp-pack-title lang-es">{pack.title.es}</span>}
                        {isMain && <span class="lp-pack-title lang-en">{pack.title.en}</span>}
                        {isMain && (
                          <span class="lp-pack-count lang-es">{cardsInPack(pack.id)} cartas</span>
                        )}
                        {isMain && (
                          <span class="lp-pack-count lang-en">{cardsInPack(pack.id)} cards</span>
                        )}
                        <span class="lp-pack-seal lp-hanzi" lang="zh-Hans">{pack.mark}</span>
                        <span class="lp-pack-crimp lp-pack-crimp-bottom" />
                      </div>
                      {isMain && <span class="lp-pack-tear" />}
                    </div>
                  );
                })
              }
            </div>
          </div>
        </section>
      </main>
    </div>

    <footer class="lp-footer">
      <div class="lp-shell">
        <div class="lp-footer-inner">
          <div>
            <p class="lp-eyebrow lang-es">Tu turno</p>
            <p class="lp-eyebrow lang-en">Your turn</p>
            <h2>
              <span class="lang-es">Tu primera carta ya está en la mesa: <span class="lp-hanzi" lang="zh-Hans">你</span>.</span>
              <span class="lang-en">Your first card is already on the table: <span class="lp-hanzi" lang="zh-Hans">你</span>.</span>
            </h2>
            <p class="lp-footer-note">
              <span class="lang-es">
                Empieza donde empezó la clase: pronombres, saludos y las primeras frases. Sin
                cuenta obligatoria, con progreso guardado en tu dispositivo.
              </span>
              <span class="lang-en">
                Start where the class started: pronouns, greetings, and the first phrases. No
                account needed, with your progress saved on your device.
              </span>
            </p>
            <div class="lp-footer-actions">
              <a class="lp-button lp-button-primary lang-es" href={appUrl("es")}>Abrir las cartas</a>
              <a class="lp-button lp-button-primary lang-en" href={appUrl("en")}>Open the cards</a>
            </div>

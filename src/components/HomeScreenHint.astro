---
const base = import.meta.env.BASE_URL;
---

<aside class="home-screen-hint" data-home-screen-hint hidden>
  <img src={`${base}yuwenke-mark.png`} alt="" width="40" height="40" />
  <div>
    <div data-home-screen-platform="safari" hidden>
      <div data-home-screen-lang="es" lang="es" hidden>
        <strong>Yuwenke en tu pantalla de inicio</strong>
        <p>
          En Safari, toca <span class="home-screen-action">Compartir <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 15V3m-4 4 4-4 4 4M8 9H5v12h14V9h-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>.
          Si está oculto, abre primero <span class="home-screen-action">Menú de página <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 5h18M3 12h18M3 19h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></span> o <span class="home-screen-action">Más <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /></svg></span>.
        </p>
        <p>Desplázate hacia abajo (o toca Ver más) → Añadir a pantalla de inicio → activa Abrir como app web → Añadir.</p>
      </div>
      <div data-home-screen-lang="en" lang="en" hidden>
        <strong>Yuwenke on your Home Screen</strong>
        <p>
          In Safari, tap <span class="home-screen-action">Share <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 15V3m-4 4 4-4 4 4M8 9H5v12h14V9h-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>.
          If hidden, first open <span class="home-screen-action">Page Menu <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 5h18M3 12h18M3 19h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></span> or <span class="home-screen-action">More <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /></svg></span>.
        </p>
        <p>Scroll down (or tap View More) → Add to Home Screen → turn on Open as Web App → Add.</p>
      </div>
    </div>
    <div data-home-screen-platform="android" hidden>
      <div data-home-screen-lang="es" lang="es" hidden>
        <strong>Yuwenke en tu pantalla de inicio</strong>
        <p><button type="button" data-home-screen-install>Instalar Yuwenke</button></p>
      </div>
      <div data-home-screen-lang="en" lang="en" hidden>
        <strong>Yuwenke on your Home Screen</strong>
        <p><button type="button" data-home-screen-install>Install Yuwenke</button></p>
      </div>
    </div>
  </div>
  <button type="button" data-home-screen-dismiss aria-label="Dismiss suggestion">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>
</aside>

<script>
  import { initHomeScreenHint } from "../lib/homeScreen";

  const hint = document.querySelector<HTMLElement>("[data-home-screen-hint]");
  if (hint) initHomeScreenHint(hint);
</script>

<style>
  .home-screen-hint {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 12px;
    width: min(720px, calc(100% - 32px));
    margin: 12px auto;
    padding: 12px 8px 12px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .home-screen-hint[hidden],
  [data-home-screen-lang][hidden],
  [data-home-screen-platform][hidden] {
    display: none;
  }

  .home-screen-hint strong {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .home-screen-hint p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .home-screen-action {
    white-space: nowrap;
  }

  .home-screen-action svg {
    vertical-align: text-bottom;
  }

  [data-home-screen-dismiss] {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  [data-home-screen-dismiss]:hover {
    background: var(--surface-warm);
    color: var(--ink);
  }

  [data-home-screen-install] {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--jade);
    border-radius: 8px;
    background: var(--jade);
    color: var(--surface);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* Keep the conversation's viewport and keyboard layout free of the hint. */
  :global(body:has(.app-shell--chat)) .home-screen-hint {
    display: none;
  }

  @media (max-width: 959px) {
    .home-screen-hint {
      margin-bottom: calc(164px + env(safe-area-inset-bottom));
    }
  }
</style>
